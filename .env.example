# Copy to .env and fill in:   cp .env.example .env
# Every script reads this file (and only this file) for keys. It is git-ignored.
# You need PROXY_API_KEY plus the keys of the providers you will actually call;
# an alias whose key is missing fails with a 401 at call time, nothing else breaks.

# ─── The proxy (what every benchmark talks to) ───────────────────────────────
# Any string you choose. The proxy accepts it as its master key and the benchmarks
# send it as their "OpenAI" key; it is never sent to a provider.
PROXY_API_KEY=sk-local-change-me
# Where the benchmarks send their calls. Change only if you change PROXY_PORT.
OPENAI_BASE_URL=http://localhost:4000/v1
TRACE_PROXY_BASE_URL=http://localhost:4000/v1

# ─── Provider keys, read by the two proxies only ─────────────────────────────
# Which alias uses which key is in proxy/llm_cost_tracker/proxy/config.yaml (agents)
# and LLMaJ/proxy/config.yaml (judges).
OPENAI_API_KEY=                     # gpt-* aliases; τ²-bench's user simulator when USER_MODEL is a gpt model
ANTHROPIC_API_KEY=                  # claude-* aliases; τ²-bench's user simulator when USER_MODEL=claude-*
GEMINI_API_KEY=                     # gemini-* aliases; MCP-Atlas's scorer (benchmarks/mcp-atlas/score.sh)
# kimi-k3 aliases: any OpenAI-compatible endpoint that serves the model under the
# name "kimi-k3" and accepts `reasoning_effort` (e.g. https://<host>/v1).
KIMI_BASE_URL=
KIMI_API_KEY=
# Self-hosted Qwen3-* aliases (SGLang). Leave unset unless you serve them.
# SGLANG_BASE_URL=http://localhost:30000/v1

# ─── LLMaJ (the judge) ───────────────────────────────────────────────────────
# The judge proxy (LLMaJ/proxy/run.sh, :4500) uses the provider keys above.
LLMAJ_BASE_URL=http://127.0.0.1:4500/v1

# MCP-Atlas has a SECOND env file, benchmarks/mcp-atlas/src/.env, holding the keys of
# its 36 MCP servers (Airtable, Brave Search, GitHub, Google Workspace, ...). setup.sh
# creates it from upstream's env.template; fill in what you have. Servers without a key
# show as offline and their tasks fail; pass --skip-health-check to run anyway.
