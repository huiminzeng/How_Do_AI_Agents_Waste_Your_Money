diff --git a/src/tau2/config.py b/src/tau2/config.py
index d8a8ace..525bca8 100644
--- a/src/tau2/config.py
+++ b/src/tau2/config.py
@@ -1,3 +1,14 @@
+import os
+
+# Untracked (non-agent) LLM calls: pin the first-party endpoint + key explicitly so they
+# bypass the cost proxy even when OPENAI_BASE_URL is exported for the traced agent.
+# OPENAI_DIRECT_API_KEY is preferred: run scripts repoint OPENAI_API_KEY at the proxy's
+# master key, so it is NOT the first-party key inside a traced run.
+_DIRECT_LLM_ARGS = {
+    "api_base": os.environ.get("OPENAI_DIRECT_BASE_URL", "https://api.openai.com/v1"),
+    "api_key": os.environ.get("OPENAI_DIRECT_API_KEY") or os.environ.get("OPENAI_API_KEY"),
+}
+
 # =============================================================================
 # SIMULATION DEFAULTS (overridable via CLI)
 # =============================================================================
@@ -21,13 +32,23 @@ DEFAULT_LLM_TEMPERATURE_USER = 0.0
 DEFAULT_LLM_ARGS_AGENT = {"temperature": DEFAULT_LLM_TEMPERATURE_AGENT}
 DEFAULT_LLM_ARGS_USER = {"temperature": DEFAULT_LLM_TEMPERATURE_USER}
 
-DEFAULT_LLM_NL_ASSERTIONS = "gpt-4.1-2025-04-14"
-DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE = 0.0
-DEFAULT_LLM_NL_ASSERTIONS_ARGS = {"temperature": DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE}
+# Judge / env-interface LLMs are NOT the tested agent: their tokens must never be
+# cost-tracked. They are pinned to the first-party OpenAI endpoint so that a
+# process-wide OPENAI_BASE_URL (which points at the LiteLLM cost proxy for the agent)
+# cannot silently route them through it. See _DIRECT_LLM_ARGS below.
+DEFAULT_LLM_NL_ASSERTIONS = "gpt-5.5"
+DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE = 1.0
+DEFAULT_LLM_NL_ASSERTIONS_ARGS = {
+    "temperature": DEFAULT_LLM_NL_ASSERTIONS_TEMPERATURE,
+    **_DIRECT_LLM_ARGS,
+}
 
 DEFAULT_LLM_ENV_INTERFACE = "gpt-4.1-2025-04-14"
 DEFAULT_LLM_ENV_INTERFACE_TEMPERATURE = 0.0
-DEFAULT_LLM_ENV_INTERFACE_ARGS = {"temperature": DEFAULT_LLM_ENV_INTERFACE_TEMPERATURE}
+DEFAULT_LLM_ENV_INTERFACE_ARGS = {
+    "temperature": DEFAULT_LLM_ENV_INTERFACE_TEMPERATURE,
+    **_DIRECT_LLM_ARGS,
+}
 
 DEFAULT_LLM_EVAL_USER_SIMULATOR = "claude-opus-4-5"
 
