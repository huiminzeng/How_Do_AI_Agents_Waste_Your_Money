+
+    # Recompute the headline metrics from the merged `results`, never from the
+    # accumulators built during this invocation.
+    #
+    # `n_pass_hat`, `n_pass_at` and `score_sum` are incremented inside the task
+    # loop, so on a --rerun-errors or --continue run they cover only the tasks
+    # that executed THIS time. The summary then mixed two populations: `tasks`
+    # and `errored` counted the merged 161 while `pass_hat_3` counted the 18
+    # that were rerun. Measured on one kimi-k3 cell: the file said
+    # pass^3 = 12 and avg_score = 0.865 where the merged truth is 128 and
+    # 0.846. Nothing errors out and 12 is a plausible-looking number, so the
+    # only signal was that the pass count fell while the score rose.
+    _scored = [r for r in results if not r.get("error") and r.get("trials")]
+    finished_tasks = len(_scored)
+    n_pass_hat = sum(
+        1 for r in _scored if all(t.get("passed") for t in r["trials"])
+    )
+    n_pass_at = sum(
+        1 for r in _scored if any(t.get("passed") for t in r["trials"])
+    )
+    avg_score_final = (
+        sum(
+            sum(t["task_score"] for t in r["trials"]) / len(r["trials"])
+            for r in _scored
+        )
+        / finished_tasks
+        if finished_tasks
+        else 0.0
+    )
     total_model_input_tokens = sum(
         tr.get("model_input_tokens", tr.get("input_tokens", 0))
         for r in results for tr in r.get("trials", [])
