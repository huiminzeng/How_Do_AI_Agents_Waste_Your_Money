@@ -0,0 +1,24 @@
+# Minimal config for proxy smoke tests (OpenAI GPT via LiteLLM proxy).
+# No reasoning_effort / temperature — GPT-5.x rejects unsupported params.
+#
+# api_key is the PROXY master key, not a first-party OpenAI key: base_url below is the
+# local cost proxy, which authenticates with general_settings.master_key.
+
+model:
+  api_key: ${PROXY_API_KEY}
+  base_url: http://localhost:4000/v1
+  model_id: gpt-5.2-chat
+  context_window: 128000
+  temperature: null
+
+# Judge stays disabled here. When enabling it, keep judge.base_url OFF the proxy origin
+# (e.g. https://api.openai.com/v1) so judge tokens are never counted as agent cost.
+judge:
+  enabled: false
+
+defaults:
+  trace_dir: traces
+  tasks_dir: tasks
+
+sandbox:
+  enabled: false
